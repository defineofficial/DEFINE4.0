# Copy to .env and fill in. Never commit .env.

# --- App ---
WEB_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
# At least 32 random characters. Make one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# If this is missing, a temporary key is used and everyone is signed out when the server restarts.
SECRET_KEY=
# Set to false to close public sign-up and create accounts with scripts/create_organizer.py
ALLOW_REGISTRATION=true

# --- Database and queue ---
# Leave DATABASE_URL empty to run in mock mode (no database needed, any login works).
# Setup steps: docs/database-setup-windows.md. The database must use UTF8 encoding.
DATABASE_URL=
# A separate, empty database. The database tests delete everything in it.
TEST_DATABASE_URL=
# Example values:
#   DATABASE_URL=postgresql://eventreach:your-password@localhost:5432/eventreach
#   TEST_DATABASE_URL=postgresql://eventreach:your-password@localhost:5432/eventreach_test
REDIS_URL=redis://localhost:6379/0

# --- Personal data protection ---
# 32-byte key, base64. Encrypts phone numbers at rest.
ENCRYPTION_KEY=
# Random string. Salts the phone hash used for dedupe and opt-out matching.
PHONE_HASH_PEPPER=
# Recordings are deleted this many days after the call.
RECORDING_RETENTION_DAYS=30
# Where voice and language processing runs. Write the real region here and in the privacy note.
PROCESSING_REGION=

# --- Exotel (provided at kickoff) ---
EXOTEL_ACCOUNT_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_SUBDOMAIN=
EXOTEL_CALLER_ID=

# --- AI (transcription, extraction, translation) ---
LLM_API_KEY=
LLM_MONTHLY_BUDGET_USD=20

# --- Payments (use test keys) ---
PAYMENT_KEY_ID=
PAYMENT_KEY_SECRET=
PAYMENT_WEBHOOK_SECRET=

# --- Email ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# --- Channels: keep true until the real accounts are approved ---
MOCK_CHANNELS=true

# --- Private storage (posters and voice notes) ---
# Folder for uploads. Leave empty to use api/uploads/ (git-ignored). Never serve this folder directly.
STORAGE_DIR=
# How long a file link works, in seconds (30 to 604800). 900 = 15 minutes.
STORAGE_LINK_TTL_SECONDS=900
# Public address of the API, put in front of file links sent by email or SMS. Example: https://api.example.org
PUBLIC_API_URL=
